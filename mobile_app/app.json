{
  "expo": {
    "name": "LittleNet",
    "slug": "littlenet",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "littlenet",
    "userInterfaceStyle": "light",
    "icon": "../static/icons/app_logo.png",
    "android": {
      "package": "com.littlenet.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "../static/icons/app_logo.png",
        "backgroundColor": "#FFF9F2"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.littlenet.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "LittleNet uses the camera for live face checks."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LittleNet uses a selected photo only when you choose to create a post.",
          "cameraPermission": "LittleNet uses the camera for live face checks and content you choose to create.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "../static/icons/app_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF9F2"
        }
      ]
    ],
    "owner": "anilkumar09",
    "extra": {
      "eas": {
        "projectId": "e415f1da-b67c-4fd2-8f9a-61ac16d211be"
      }
    }
  }
}
