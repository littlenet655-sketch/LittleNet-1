{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "test-dist",
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "src/api/**/*.ts",
    "src/auth/session.ts",
    "src/auth/backends.ts",
    "src/navigation/gates.ts",
    "src/kids/social.ts",
    "src/quiz/decision.ts",
    "src/video/types.ts",
    "src/video/playbackPolicy.ts",
    "src/video/reelPlaybackMetrics.ts"
  ]
}
